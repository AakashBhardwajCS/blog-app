{
  "name": "blog-platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "format": "prettier --write \"{frontend,backend}/**/*.{ts,tsx,css,json,md}\" \"*.{json,md}\" && npm run prisma:format --workspace=backend"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
