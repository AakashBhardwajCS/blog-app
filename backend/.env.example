DATABASE_URL="postgresql://postgres:postgres@localhost:5432/<DATABASE_NAME>?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001
# Comma-separated allow-list used when NODE_ENV=production
FRONTEND_URL="http://localhost:3000"
SEAWEED_ENDPOINT="localhost"
SEAWEED_PORT="8333"
SEAWEED_USE_SSL="false"
SEAWEED_ACCESS_KEY="someAccessKey"
SEAWEED_SECRET_KEY="someSecretKey"
SEAWEED_BUCKET="<bucket name>"
SEAWEED_PUBLIC_URL="http://localhost:8333"

# --- RAG knowledge assistant ---
# pgvector database for article chunks (defaults to DATABASE_URL)
PGVECTOR_DATABASE_URL="postgresql://postgres:password@localhost:5433/<dbname>?schema=public"
# OpenAI-compatible chat endpoint used to write answers (Ollama by default)
LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="llama3.1:8b"
# Semantic embedding model (e.g. `ollama pull nomic-embed-text`). Leave empty to use
# the built-in hashed keyword embedding. EMBEDDING_BASE_URL defaults to LOCAL_LLM_BASE_URL.
EMBEDDING_MODEL="nomic-embed-text"
# Optional tuning
# RAG_MIN_SIMILARITY=0.5
# RAG_MAX_CONTEXT_CHARS=10000
# RAG_LLM_TIMEOUT_MS=30000
