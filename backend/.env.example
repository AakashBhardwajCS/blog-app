DATABASE_URL="postgresql://postgres:postgres@localhost:5432/<DATABASE_NAME>?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001
# Comma-separated allow-list used when NODE_ENV=production
FRONTEND_URL="http://localhost:3000"
SEAWEED_ENDPOINT="localhost"
SEAWEED_PORT="8333"
SEAWEED_USE_SSL="false"
SEAWEED_ACCESS_KEY="someAccessKey"
SEAWEED_SECRET_KEY="someSecretKey"
SEAWEED_BUCKET="<bucket name>"
SEAWEED_PUBLIC_URL="http://localhost:8333"
